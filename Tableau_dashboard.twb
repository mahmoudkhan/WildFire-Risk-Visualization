            <column-instance column='[county_label]' derivation='None' name='[none:county_label:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2022310553964544]' derivation='Sum' name='[sum:Calculation_2022310553964544:qk]' pivot='key' type='quantitative' />
            <column caption='Svi' datatype='real' name='[svi]' role='measure' type='quantitative' />
            <column caption='Wildfire Risk' datatype='real' name='[wildfire_risk]' role='measure' type='quantitative' />
