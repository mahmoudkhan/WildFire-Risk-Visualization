    <worksheet name='Risk–Vulnerability Scatterplot'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_wildfire_svi_counties' name='federated.0rw7mjr12d82y70zwvgi0081pyup' />
          </datasources>
          <datasource-dependencies datasource='federated.0rw7mjr12d82y70zwvgi0081pyup'>
            <column caption='Risk–Vulnerability Quadrant' datatype='string' name='[Calculation_2022310554300418]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [wildfire_risk] &gt;= 0.75&#13;&#10;AND [svi] &gt;= 0.75 THEN&#13;&#10;    &quot;High Risk / High Vulnerability&quot;&#13;&#10;&#13;&#10;ELSEIF [wildfire_risk] &gt;= 0.75 THEN&#13;&#10;    &quot;High Risk / Lower Vulnerability&quot;&#13;&#10;&#13;&#10;ELSEIF [svi] &gt;= 0.75 THEN&#13;&#10;    &quot;Lower Risk / High Vulnerability&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;Lower Risk / Lower Vulnerability&quot;&#13;&#10;END' />
            </column>
            <column caption='Wildfire Risk Level' datatype='string' name='[Calculation_2298562959937541]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [wildfire_risk] &lt; 0.3333 THEN &quot;Low&quot;&#13;&#10;ELSEIF [wildfire_risk] &lt; 0.6667 THEN &quot;Moderate&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
            </column>
            <column caption='SVI Level' datatype='string' name='[Calculation_2298562960035846]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [svi] &lt; 0.3333 THEN &quot;Low&quot;&#13;&#10;ELSEIF [svi] &lt; 0.6667 THEN &quot;Moderate&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
            </column>
            <column caption='Bivariate Risk Class' datatype='string' name='[Calculation_2298562960113671]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_2298562960035846] + &quot; SVI / &quot; +&#13;&#10;[Calculation_2298562959937541] + &quot; wildfire&quot;' />
            </column>
            <column caption='County Clean' datatype='string' name='[Calculation_2298562961633288]' role='dimension' semantic-role='[County].[Name]' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([county], &quot;,&quot;) THEN&#13;&#10;    TRIM(SPLIT([county], &quot;,&quot;, 1))&#13;&#10;ELSE&#13;&#10;    TRIM([county])&#13;&#10;END' />
              <semantic-values semantic-role='[County].[Name]'>
                <semantic-value key='&quot;Chugach Census Area&quot;' value='&quot;Chugach&quot;' />
              </semantic-values>
              <semantic-values semantic-role='[Geographical].[Latitude]'>
                <semantic-value key='&quot;Copper River Census Area&quot;' value='61.804727999999997' />
              </semantic-values>
              <semantic-values semantic-role='[Geographical].[Longitude]'>
                <semantic-value key='&quot;Copper River Census Area&quot;' value='-144.372952' />
              </semantic-values>
            </column>
            <column-instance column='[county_label]' derivation='Attribute' name='[attr:county_label:nk]' pivot='key' type='nominal' />
            <column caption='Buildings' datatype='integer' name='[buildings]' role='measure' type='quantitative' />
            <column caption='County' datatype='string' name='[county]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
            <column caption='County Label' datatype='string' name='[county_label]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
            <column-instance column='[Calculation_2022310554300418]' derivation='None' name='[none:Calculation_2022310554300418:nk]' pivot='key' type='nominal' />
            <column-instance column='[county_label]' derivation='None' name='[none:county_label:nk]' pivot='key' type='nominal' />
            <column caption='Population' datatype='integer' name='[population]' role='measure' type='quantitative' />
            <column caption='State' datatype='string' name='[state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[buildings]' derivation='Sum' name='[sum:buildings:qk]' pivot='key' type='quantitative' />
            <column-instance column='[population]' derivation='Sum' name='[sum:population:qk]' pivot='key' type='quantitative' />
            <column-instance column='[svi]' derivation='Sum' name='[sum:svi:qk]' pivot='key' type='quantitative' />
            <column-instance column='[wildfire_risk]' derivation='Sum' name='[sum:wildfire_risk:qk]' pivot='key' type='quantitative' />
            <column caption='Svi' datatype='real' name='[svi]' role='measure' type='quantitative' />
            <column caption='Wildfire Risk' datatype='real' name='[wildfire_risk]' role='measure' type='quantitative' />
