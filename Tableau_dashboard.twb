      <table>
        <view>
          <datasources>
            <datasource caption='tableau_wildfire_svi_counties' name='federated.0rw7mjr12d82y70zwvgi0081pyup' />
          </datasources>
          <datasource-dependencies datasource='federated.0rw7mjr12d82y70zwvgi0081pyup'>
            <column caption='Compound Priority - Tableau' datatype='real' name='[Calculation_2022310553964544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([wildfire_risk] + [svi]) / 2' />
